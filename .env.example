APP_NAME="EduPortal LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=portal
# DB_USERNAME=sail
# DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@eduportal.local"
MAIL_FROM_NAME="${APP_NAME}"

CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Portal Settings & Feature Flags
PORTAL_MODULE_NURSERY=true
PORTAL_MODULE_INSTITUTE=true
PORTAL_STUDENT_ID_FORMAT="INS-{YY}-{SEQ5}"
PORTAL_ATTENDANCE_WINDOW_BEFORE_MIN=30
PORTAL_ATTENDANCE_WINDOW_AFTER_MIN=30
PORTAL_ATTENDANCE_LATE_AFTER_MIN=15
PORTAL_ATTENDANCE_BLOCK_IF_UNPAID=false
PORTAL_FEES_GRACE_DAYS=7
PORTAL_FEES_REMINDER_DAYS_BEFORE=3
PORTAL_PRINTING_MAX_PER_MATERIAL_PER_MONTH=1
PORTAL_UPLOADS_MAX_SIZE_MB=50
PORTAL_UPLOADS_CHUNK_SIZE_MB=2
PORTAL_UPLOADS_ALLOWED_TYPES="mp4,mov,webm,pdf,jpg,png,zip"
PORTAL_UPLOADS_ZIP_MAX_ENTRIES=200
PORTAL_UPLOADS_ZIP_MAX_UNCOMPRESSED_MB=200
PORTAL_SUBMISSIONS_ALLOW_LATE=true
PORTAL_SUBMISSIONS_LOCK_AFTER_REVIEW=true
PORTAL_QUIZ_LIVE_REQUIRE_CHECKIN=true
PORTAL_CHAT_ENABLED=true
PORTAL_CHAT_HOURS=null
PORTAL_CHAT_RETENTION_DAYS=365
PORTAL_NOTIFICATIONS_CHANNELS="mail,database"

# Demo User Passwords
SUPER_ADMIN_PASSWORD=password
ADMIN_PASSWORD=password
TEACHER_PASSWORD=password
PARENT_PASSWORD=password
STUDENT_PASSWORD=password
PRINT_STAFF_PASSWORD=password
CASHIER_PASSWORD=password

VITE_APP_NAME="${APP_NAME}"
